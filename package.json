{
  "name": "cos-similarity",
  "version": "2.0.0",
  "description": "Computes the cosine similarity between two vectors",
  "keywords": [
    "array",
    "cos",
    "cosine",
    "difference",
    "distance",
    "math",
    "similarity",
    "vector"
  ],
  "homepage": "https://github.com/rtomrud/cos-similarity#readme",
  "bugs": {
    "url": "https://github.com/rtomrud/cos-similarity/issues"
  },
  "license": "MIT",
  "author": "Artem Rudenko <rtomrud@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtomrud/cos-similarity.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "bench": "vp test bench --reporter=verbose"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "compute-cosine-similarity": "^1.1.0",
    "cosine-similarity": "^1.0.1",
    "cosine-similarity-threshold": "^1.0.1",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "download"
    }
  }
}
